PORT=3000
NODE_ENV=production
SESSION_SECRET=your-secret-key-here
ADMIN_SETUP_TOKEN=your-secure-token-here

# Memory configuration
NODE_OPTIONS=--max-old-space-size=4096

DATABASE_URL=postgresql://user:password@host:5432/database
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
DEBUG_MODE=false

# ============================================
# PAYMENT GATEWAY CONFIGURATION
# ============================================

# MonCash Payment Gateway (Haiti)
# Obtain credentials from: https://moncashbutton.digicelgroup.com/
# Steps to get credentials:
#   1. Create a merchant account at the MonCash website
#   2. Complete KYC verification
#   3. Get your Client ID and Client Secret from the dashboard
MONCASH_CLIENT_ID=your-moncash-client-id
MONCASH_CLIENT_SECRET=your-moncash-client-secret
# Alternate name (both are supported for backwards compatibility):
MONCASH_SECRET_KEY=your-moncash-secret-key
MONCASH_MODE=sandbox
# Mode: sandbox or production
# Sandbox endpoint: https://sandbox.moncashbutton.digicelgroup.com/Api/
# Production endpoint: https://moncashbutton.digicelgroup.com/Api/

# NatCash Payment Gateway (Haiti)
# Contact NatCash for API credentials
NATCASH_API_KEY=your-natcash-api-key
NATCASH_MERCHANT_ID=your-natcash-merchant-id
NATCASH_MODE=sandbox
# Mode: sandbox or production

# Manual Payment Settings
# Business wallet numbers for manual/USSD payments
# MonCash merchant account: +509 3666 2371
# NatCash merchant account: +509 3220 4333
MONCASH_WALLET_NUMBER=+509 3666 2371
NATCASH_WALLET_NUMBER=+509 3220 4333
BUSINESS_PHONE_NUMBER=+509 3666 2371

# ============================================
# SMS NOTIFICATION CONFIGURATION
# ============================================

# Twilio SMS Configuration (Recommended)
# Get credentials from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Alternative: Custom SMS Gateway
# If using a local/custom SMS provider, configure these:
CUSTOM_SMS_GATEWAY_URL=https://sms-gateway.example.com/send
CUSTOM_SMS_GATEWAY_API_KEY=your-sms-api-key
CUSTOM_SMS_GATEWAY_SENDER=YourBusiness

# Admin notification phone numbers (comma-separated for multiple admins)
ADMIN_NOTIFICATION_PHONES=509-1111-2222,509-3333-4444

# SMS Provider: twilio, custom, or disabled
SMS_PROVIDER=twilio
