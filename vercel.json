{
  "version": 2,
  "builds": [
    { 
      "src": "raffle-app/server.js", 
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { 
      "src": "/health", 
      "dest": "/raffle-app/server.js" 
    },
    { 
      "src": "/api/health", 
      "dest": "/raffle-app/server.js" 
    },
    { 
      "src": "/(.*)", 
      "dest": "/raffle-app/server.js" 
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
