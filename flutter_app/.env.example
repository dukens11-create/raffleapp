# Environment Variables Example
# Copy this file to .env and fill in your actual values

# API Configuration
API_BASE_URL=http://localhost:3000
API_TIMEOUT=30000

# MonCash Payment Gateway
MONCASH_CLIENT_ID=your_moncash_client_id
MONCASH_CLIENT_SECRET=your_moncash_client_secret
MONCASH_ENDPOINT=https://sandbox.moncashbutton.digicelgroup.com

# NatCash Payment Gateway
NATCASH_API_KEY=your_natcash_api_key
NATCASH_ENDPOINT=https://sandbox-api.natcash.ht

# Firebase Configuration
FIREBASE_PROJECT_ID=grate-genyen-dev
FIREBASE_APP_ID_ANDROID=your_android_app_id
FIREBASE_APP_ID_IOS=your_ios_app_id
FIREBASE_API_KEY=your_firebase_api_key

# App Configuration
APP_NAME=Grate Genyen
APP_VERSION=1.0.0
ENVIRONMENT=development

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_CRASHLYTICS=false
ENABLE_DEBUG_LOGGING=true
ENABLE_OFFLINE_MODE=true

# Security
JWT_SECRET=your_jwt_secret
ENCRYPTION_KEY=your_encryption_key

# External Services
SENTRY_DSN=your_sentry_dsn
MIXPANEL_TOKEN=your_mixpanel_token
