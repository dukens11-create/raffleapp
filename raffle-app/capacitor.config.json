{
  "appId": "com.grategenyen.raffle",
  "appName": "Grate Genyen",
  "webDir": "www",
  "android": {
    "buildOptions": {}
  },
  "ios": {
    "contentInset": "automatic",
    "scheme": "Grate Genyen"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#667eea",
      "showSpinner": true,
      "spinnerColor": "#ffffff"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "Camera": {
      "ios": {
        "NSCameraUsageDescription": "This app uses the camera to scan barcodes and tickets."
      },
      "android": {
        "permissions": ["CAMERA"]
      }
    }
  }
}
